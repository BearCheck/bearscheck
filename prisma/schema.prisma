generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  password         String?
  role             Role         @default(USER)
  emailVerified    DateTime?
  image            String?
  resetToken       String?      @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  comparisons      Comparison[]
  accounts         Account[]
  sessions         Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id              String           @id @default(cuid())
  raisonSociale   String
  siret           String           @unique
  email           String           @unique
  emailPro        String?
  telephone       String?
  adresse         String?
  nomResponsable  String?
  password        String
  status          CompanyStatus    @default(PENDING)
  affiliateCode   String           @unique
  qrCodeUrl       String?
  commissionRate  Float            @default(0)
  ribIban         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  commissions     Commission[]
  affiliateEvents AffiliateEvent[]
}

model Comparison {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  formData      Json
  results       Json
  affiliateCode String?
  completed     Boolean  @default(false)
  converted     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model AffiliateEvent {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  type          EventType
  ipHash        String?
  userAgent     String?
  createdAt     DateTime  @default(now())
}

model Commission {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  amount      Float
  status      CommissionStatus @default(PENDING)
  description String?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  ipHash    String?
  userAgent String?
  refCode   String?
  createdAt DateTime @default(now())
}

enum Role {
  USER
  COMPANY_ADMIN
  ADMIN
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EventType {
  SCAN
  COMPARISON
  CONVERSION_INTENT
}

enum CommissionStatus {
  PENDING
  IN_PROGRESS
  PAID
}

model SecurityLog {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  ip        String?
  userAgent String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

// ─── GESTION FINANCIÈRE ───────────────────────────

model Expense {
  id           String          @id @default(cuid())
  titre        String
  montant      Float
  categorie    ExpenseCategory
  type         ExpenseType
  recurrent    Boolean         @default(false)
  dateDepense  DateTime
  description  String?
  justificatif String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Revenue {
  id          String   @id @default(cuid())
  titre       String
  montant     Float
  source      String
  dateRevenu  DateTime
  description String?
  createdAt   DateTime @default(now())
}

model TaxDeclaration {
  id              String    @id @default(cuid())
  trimestre       Int
  annee           Int
  chiffreAffaires Float
  cotisations     Float
  dateLimite      DateTime
  datePaiement    DateTime?
  statut          TaxStatus @default(A_PAYER)
  createdAt       DateTime  @default(now())
}

// ─── CALENDRIER ──────────────────────────────────

model CalendarEvent {
  id          String        @id @default(cuid())
  titre       String
  description String?
  dateDebut   DateTime
  dateFin     DateTime?
  allDay      Boolean       @default(false)
  couleur     String        @default("#C9A84C")
  categorie   EventCategory
  rappel      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ─── ROADMAP ─────────────────────────────────────

model RoadmapTask {
  id           String        @id @default(cuid())
  titre        String
  description  String?
  statut       TaskStatus    @default(A_FAIRE)
  priorite     Priority      @default(MOYENNE)
  dateDebut    DateTime?
  dateFin      DateTime?
  dureeEstimee Int?
  progression  Int           @default(0)
  ordre        Int           @default(0)
  parentId     String?
  parent       RoadmapTask?  @relation("SubTasks", fields: [parentId], references: [id])
  sousTaches   RoadmapTask[] @relation("SubTasks")
  tags         String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── ENUMS ───────────────────────────────────────

enum ExpenseCategory {
  HEBERGEMENT
  DOMAINE
  DOMICILIATION
  MARKETING
  LOGICIELS
  FORMATION
  COMPTABILITE
  ASSURANCE
  ORIAS
  AUTRE
}

enum ExpenseType {
  MENSUEL
  EXCEPTIONNEL
}

enum TaxStatus {
  A_PAYER
  PAYE
  EN_RETARD
}

enum EventCategory {
  REUNION
  DEADLINE
  ADMINISTRATIF
  FISCAL
  PERSONNEL
  AUTRE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  EN_PAUSE
  TERMINE
  ANNULE
}

enum Priority {
  CRITIQUE
  HAUTE
  MOYENNE
  BASSE
}
